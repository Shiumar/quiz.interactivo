# ============================================
# Variables de Entorno para Docker
# ============================================

# PostgreSQL (Credenciales genéricas para desarrollo)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quiz_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# URL de Conexión para la App (Debe coincidir con lo de arriba)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:postgres@db:5432/quiz_db?schema=public

# Node Environment
NODE_ENV=production
PORT=3000

# Configuración de Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000