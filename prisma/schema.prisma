generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- MODELOS DEL QUIZ (Estructura) ---

model Quiz {
  internalId Int       @id @default(autoincrement())
  id         String    @unique @default(uuid())
  title      String
  questions  Question[]
  createdAt  DateTime  @default(now())
  // Relación inversa: Un quiz tiene muchas partidas jugadas
  sessions   GameSession[]
}

model Question {
  internalId      Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  text            String
  quiz            Quiz     @relation(fields: [quizInternalId], references: [internalId], onDelete: Cascade, onUpdate: Cascade)
  quizInternalId  Int
  options         Option[]
  // Relación inversa para estadísticas
  playerResponses PlayerResponse[]
}

model Option {
  internalId         Int      @id @default(autoincrement())
  id                 String   @unique @default(uuid())
  text               String
  isCorrect          Boolean  @default(false)
  question           Question @relation(fields: [questionInternalId], references: [internalId], onDelete: Cascade, onUpdate: Cascade)
  questionInternalId Int
  
  // Relación inversa
  chosenBy           PlayerResponse[]
}

// --- MODELOS DEL JUGADOR ---

model Player {
  id        String   @id @default(uuid())
  username  String   @unique // Nombre único
  createdAt DateTime @default(now())
  // Historial de partidas de este jugador
  sessions  GameSession[]
}

model GameSession {
  id             String   @id @default(uuid())
  // Jugador
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId       String
  // Quiz jugado
  quiz           Quiz     @relation(fields: [quizInternalId], references: [internalId], onDelete: Cascade)
  quizInternalId Int
  score          Int      // Puntaje final
  totalQuestions Int      // Total de preguntas (para calcular %)
  startedAt      DateTime @default(now())
  finishedAt     DateTime @default(now())
  
  // Respuestas detalladas
  responses      PlayerResponse[]
}

model PlayerResponse {
  id             String      @id @default(uuid())
  // Sesión
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  // Pregunta
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId     String
  // Opción elegida (Puede ser null si isSkipped es true)
  selectedOption Option?     @relation(fields: [optionId], references: [id], onDelete: SetNull)
  optionId       String?

  isCorrect      Boolean     // true si acertó, false si falló o saltó
  isSkipped      Boolean     @default(false) // Para diferenciar un error de un "paso"
}